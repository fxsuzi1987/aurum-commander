# Copy to .env.local for local `npm run dev`, or paste these into your
# host's Environment Variables settings (e.g. Vercel Project Settings ->
# Environment Variables) for the deployed app. Never commit real keys.

# Required — same key that powers the Obsidian Desk gold agents works fine
# here too (it's just an API key, not tied to one project).
ANTHROPIC_API_KEY=

# Strongly recommended: without these, Aurum forgets the whole conversation
# and everything it's learned about you on every cold start instead of
# remembering across sessions. Free tier at https://console.upstash.com
# (sign in with GitHub) -> Create Database -> Redis -> REST API section.
# Use a SEPARATE Redis database from the one the gold desk uses — the
# blueprint's own principle is separate workspaces per division.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The full deployed URL of the Obsidian Desk gold trading app
# (no trailing slash), e.g. https://obsidian-desk-live-suzi3.vercel.app.
# Without it, Aurum still works but can't check in on the gold desk — it
# will say so plainly rather than pretending to know its status.
OBSIDIAN_DESK_URL=
